#!/bin/sh
# Pre-commit: fast, unconditional gates (~1.4s).
#
#   1. Format the staged supported files and re-stage them.
#   2. Lint the whole project (0.7s — cheaper than filtering staged paths).
#   3. Validate all OpenSpec artifacts (0.6s).
#
# Type checking and tests are intentionally NOT here: `tsc -b` costs ~4s with
# no useful incrementality on this tree, so it runs in the pre-push hook via the
# canonical `pnpm check` instead.
#
# Bypass deliberately with `git commit --no-verify`.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# --- 1. Format staged files and re-stage -------------------------------
# NUL-delimited throughout so filenames containing spaces survive intact.
# ACMR: added, copied, modified, renamed. Skips deletions (D) so removing a
# file never fails the hook, and untracked files (never in --cached anyway).
#
# --no-error-on-unmatched-pattern is load-bearing: oxfmt exits non-zero when it
# is handed no file it recognises. Without it, committing a lone binary asset
# (this repo tracks .png/.ico/.svg, none of them formattable) or a lone file
# matched by ignorePatterns would be reported as "formatter failed" and blocked.
# The flag makes "nothing here to format" exit 0, while a genuine parse error
# still exits non-zero.
staged_list=$(mktemp)
trap 'rm -f "$staged_list"' EXIT INT TERM
git diff --cached --name-only -z --diff-filter=ACMR >"$staged_list"

if [ -s "$staged_list" ]; then
  if ! xargs -0 -r pnpm exec oxfmt --write --no-error-on-unmatched-pattern -- \
    <"$staged_list"; then
    echo "pre-commit: formatter failed; run 'pnpm format' and re-stage." >&2
    exit 1
  fi
  # Re-stage so the commit contains the formatted content. Re-adding a file the
  # formatter skipped (a binary, an ignored path) is a no-op.
  xargs -0 -r git add -- <"$staged_list"
fi

# --- 2. Lint the whole project -----------------------------------------
if ! pnpm exec oxlint; then
  echo "pre-commit: lint failed. Fix the reported issues, or bypass with --no-verify." >&2
  exit 1
fi

# --- 3. Validate OpenSpec artifacts ------------------------------------
if ! pnpm exec openspec validate --all --no-interactive; then
  echo "pre-commit: OpenSpec validation failed. Fix the artifacts, or bypass with --no-verify." >&2
  exit 1
fi

exit 0
